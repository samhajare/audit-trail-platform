NODE_ENV=development
DATABASE_URL=postgres://audit:audit@localhost:5432/audit
KAFKA_BROKERS=localhost:9092

# API
PORT=4000
CORS_ORIGIN=http://localhost:5173
# Local dev only (refused when NODE_ENV=production): skips Auth0 and injects a dev user
AUTH_DISABLED=true
DEV_TENANT_ID=company_123
DEV_PERMISSIONS=audit:read,audit:export,audit:view-sensitive,audit:replay,audit:manage
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
AUTH_TENANT_CLAIM=https://audit-explorer/tenant_id
LD_SDK_KEY=

# Consumer
CONSUMER_MAX_RETRIES=3
CONSUMER_RETRY_BASE_MS=2000
# Demo hook: events with metadata._simulateFailure=true fail processing
ALLOW_SIMULATED_FAILURES=true

# Simulator
SIMULATOR_PORT=4100
